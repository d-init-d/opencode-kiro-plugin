{
  "name": "opencode-kiro-plugin",
  "version": "0.1.8",
  "description": "Use Kiro models from Opencode via in-process kiro-cli acp bridge with API-key or existing CLI login auth.",
  "homepage": "https://github.com/d-init-d/opencode-kiro-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/d-init-d/opencode-kiro-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/d-init-d/opencode-kiro-plugin/issues"
  },
  "author": "d-init-d",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "kiro",
    "kiro-cli",
    "kiro-acp",
    "ai-sdk",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "kiro-acp-ai-provider": "^1.7.8",
    "proper-lockfile": "^4.1.2",
    "xdg-basedir": "^5.1.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.15.5",
    "@types/node": "^20.14.0",
    "@types/proper-lockfile": "^4.1.4",
    "rimraf": "^5.0.7",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
